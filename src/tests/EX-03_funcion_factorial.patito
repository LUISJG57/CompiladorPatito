programa funcFactorial;
vars
    k : entero;
nula factorial(n : entero)
vars
    i, fact : entero;
{
    {
        fact = 1;
        i = 1;
        mientras (i < n) haz {
            i = i + 1;
            fact = fact * i;
        };
        escribe("fact =", fact);
    }
};
inicio
{
    k = 1;
    mientras (k < 6) haz {
        factorial(k);
        k = k + 1;
    };
}
fin
